  "rules": {
    "cra-insecure-random-01000": {
      "id": "cra-insecure-random-01000",
      "description": "**EU Cyber Resilience Act (Annex I, Part I, Section 2(c))** requires the use of **state of the art** cryptographic mechanisms, which includes the use of cryptographically secure random number generators (CSPRNG).\n\n`java.util.Random` uses a linear congruential generator (LCG) which is **not cryptographically secure**. Its output is predictable given enough observations, making it unsuitable for:\n- Token/session ID generation\n- Nonce/IV generation for encryption\n- Salt generation for password hashing\n- Any security-sensitive random value generation\n\n**Recommended actions:**\n* Replace `new Random()` with `new SecureRandom()` for any security-relevant random number generation.\n* Replace `Math.random()` with `SecureRandom.nextDouble()` for security use cases.\n* Replace `ThreadLocalRandom.current()` with `SecureRandom` for security contexts.\n* Use `java.security.SecureRandom` which provides a CSPRNG backed by the OS entropy source.",
      "title": "CRA: Use of insecure random number generator java.util.Random",
      "severity": "mandatory",
      "effort": 5,
      "links": [
        {
          "url": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj",
          "title": "EU Cyber Resilience Act - Regulation (EU) 2024/2847"
        },
        {
          "url": "https://cwe.mitre.org/data/definitions/330.html",
          "title": "CWE-330 - Use of Insufficiently Random Values"
        }
      ],
      "labels": [
        "source",
        "domain=cloud-readiness",
        "category=insecure-random",
        "security",
        "target=azure-aks",
        "target=azure-container-apps",
        "target=azure-appservice",
        "os=windows",
        "os=linux"
      ]
    },
